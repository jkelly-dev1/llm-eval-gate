# Configuration template. Two ways to supply real credentials:
#
#   PREFERRED: keep keys in ONE private file outside every repo, e.g.
#   ~/.secrets/ai.env (chmod 600), and point ENV_FILE at it per run:
#       ENV_FILE=~/.secrets/ai.env AGENT_PROVIDER=anthropic python scripts/run_demo.py
#       ENV_FILE=~/.secrets/ai.env AGENT_PROVIDER=openai    python scripts/run_demo.py
#   Keys never appear in commands, shell history, or the repo.
#
#   ALTERNATIVE: cp .env.example .env and fill it in. NEVER commit .env.
#
# With no provider configured the system runs the deterministic offline mock.

# mock | anthropic | openai
AGENT_PROVIDER=mock

# Required only for the matching provider:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MODEL_SECONDARY=claude-sonnet-5
# OPENAI_API_KEY=sk-...
# The third voting slot. gpt-5.6-terra is 2.50/15.00 per MTok with a 1.05M
# context, the same input price as gpt-4o. gpt-5 is cheaper on paper and is
# deliberately not the default: OpenAI's own docs mark it superseded in favor of
# the GPT-5.6 line, and a gate should not be built on a model the vendor has
# moved off.
# OPENAI_MODEL=gpt-5.6-terra
# AGENT_MODEL=                      # universal override, wins for either provider
# MAX_OUTPUT_TOKENS=1200

# --- Panel -----------------------------------------------------------------
# 1 or 3. Size 1 uses the first slot only, so a single judge and a three judge
# panel can be compared on the same golden set.
# JUDGE_PANEL_SIZE=3
# honest | one_miscalibrated | two_miscalibrated
# JUDGE_PANEL_MODE=honest
# Repeats per case. Used ONLY to measure self consistency. There is no
# temperature parameter on claude-opus-5 or claude-sonnet-5 (HTTP 400), so judge
# variance is measured rather than configured away, and measuring it needs K > 1.
# JUDGE_REPEATS=3

# --- Shadow judges ---------------------------------------------------------
# Shadow judges are scored exactly like voting judges (agreement, kappa,
# confusion matrix, false pass and false fail rates, abstention rate, flip rate,
# pairwise error correlation) and are excluded from the vote, from unanimity,
# from split detection, and from every gate threshold. They answer "would a
# cheaper judge have agreed with the humans just as often" without letting the
# answer change a build outcome. Turning them off must leave the gate outcome
# identical; the demo checks that and prints the result.
# SHADOW_JUDGES=true
# SHADOW_JUDGE_MODELS=gpt-5.6-luna,gpt-4o

# --- Golden set ------------------------------------------------------------
# BASELINE_SUT_VERSION=sut.v1
# CANDIDATE_SUT_VERSION=sut.v2

# --- The committed baseline record -----------------------------------------
# The pass rate a candidate is measured against, in version control. The gate
# compares the candidate's measured pass rate against this number; approving a
# prompt version means rewriting the file with --record-baseline, which is a
# reviewable diff. See eval_gate/baseline.py.
# BASELINE_PATH=baseline.json
# Which measured version the gate treats as the candidate. Unset means "ask the
# registry", which on a fresh checkout means the version named in baseline.json.
# GATE_CANDIDATE=sut.v1

# --- Audit and registry ----------------------------------------------------
# AUDIT_LOG_PATH=audit/audit.log.jsonl
# REGISTRY_STATE_PATH=audit/registry.json

# --- Gate thresholds -------------------------------------------------------
# The regression threshold must exceed the measured noise floor or the gate
# refuses to run. On the offline panel the noise floor is about 0.083.
# GATE_MAX_PASS_RATE_DROP=0.15
# GATE_MIN_JUDGE_KAPPA=0.20
# GATE_MAX_PANEL_FALSE_PASS_RATE=0.30
# GATE_MAX_PANEL_FALSE_FAIL_RATE=0.40
# GATE_MAX_PANEL_ABSTENTION_RATE=0.20
# GATE_MAX_NEVER_DISCRIMINATE_RATE=0.70
# GATE_MAX_UNANIMITY_RATE=0.95
# GATE_MIN_CASES=20

# --- The real model measurement pass ----------------------------------------
# Sizes for the ONE demo section that calls a live model. It never gates: no exit
# code and no threshold reads anything it measures. Defaults make 460 API calls
# across three voting and two shadow judges, and the run prints that count with a
# dollar estimate before making the first call. The demo flags --real-cases,
# --real-repeat-cases and --real-repeats override these per run.
# REAL_PASS_CASES=30
# REAL_PASS_REPEAT_CASES=8
# REAL_PASS_REPEATS=3
#
# Which cases a REDUCED sweep buys: prefix (the whole set, by case id) or
# discriminating (only cases the two sut versions are labeled differently on).
# Leave this at prefix for a full 30 case run. Set it to discriminating for any
# smaller one: gc-001..gc-008 pass in BOTH versions, so an 8 case prefix measures
# kappa 1.000 for every judge and separates nothing. That run was paid for once.
# REAL_PASS_CASE_SELECTION=prefix
